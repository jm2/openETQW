# postprocess/blur_bilinear: eight taps along $parameters.xy at a quarter of the
# screen size, offset half a texel so bilinear filtering pairs neighbours.
OPTION ARB_position_invariant;
TEMP	coord, size;
MUL	size.xy, $currentRenderTexelSize, 0.25;
MOV	coord, $texCoordAttrib;
MUL	coord.xy, coord, size;
SUB	coord.y, size.y, coord.y;
MAD	result.texcoord[0], $parameters, 6.5, coord;
MAD	result.texcoord[1], $parameters, 4.5, coord;
MAD	result.texcoord[2], $parameters, 2.5, coord;
MAD	result.texcoord[3], $parameters, 0.5, coord;
MAD	result.texcoord[4], $parameters, -0.5, coord;
MAD	result.texcoord[5], $parameters, -2.5, coord;
MAD	result.texcoord[6], $parameters, -4.5, coord;
MAD	result.texcoord[7], $parameters, -6.5, coord;
