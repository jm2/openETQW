; SPDX-License-Identifier: GPL-3.0-only
; Inno Setup script template for the openETQW Windows installer. Rendered by
; tools/build/build_windows_installer.py, which fills the placeholder tokens.
; Adapted from openQ4's tools/build/openQ4Installer.iss.in at jm2/openQ4
; b37b1456 (GPL-3.0; docs/provenance.md), without the browser link handler
; and the documentation portal, with its own AppId and an optional setup icon.

#define MyAppName "openETQW"
#define MyAppVersion "@@APP_VERSION@@"
#define MyAppPublisher "openETQW contributors"
#define MyAppURL "https://github.com/jm2/openETQW"
#define MyAppExeName "openETQW-client_@@APP_ARCH@@.exe"
#define MyAppServerExeName "openETQW-ded_@@APP_ARCH@@.exe"
#define MyAppInstallRegKey "Software\\openETQW"
#define MyAppClientAppPathsKey "Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\" + MyAppExeName
#define PackageSource "@@PACKAGE_SOURCE@@"

[Setup]
AppId={{D5E05AEC-F8E3-4F42-9250-CA4A7EDBF1DC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
AppReadmeFile={app}\README.txt
DefaultDirName={code:GetDefaultInstallDir}
DefaultGroupName=openETQW
DisableProgramGroupPage=yes
UsePreviousAppDir=yes
LicenseFile=@@LICENSE_FILE@@
OutputDir=@@OUTPUT_DIR@@
OutputBaseFilename=@@OUTPUT_BASENAME@@
@@SETUP_ICON_DIRECTIVE@@
UninstallDisplayName={#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
@@ARCH_ALLOWED_DIRECTIVE@@
@@ARCH_INSTALL_MODE_DIRECTIVE@@
VersionInfoVersion=@@APP_VERSION@@
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription=openETQW Windows Installer
VersionInfoProductName={#MyAppName}
VersionInfoCopyright=Copyright (C) openETQW contributors

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional options:"; Flags: unchecked

[Files]
Source: "{#PackageSource}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Registry]
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "InstallDir"; ValueData: "{app}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "InstallArch"; ValueData: "@@APP_ARCH@@"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "InstallVersion"; ValueData: "{#MyAppVersion}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "ClientExe"; ValueData: "{app}\{#MyAppExeName}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppInstallRegKey}"; ValueType: string; ValueName: "UninstallExe"; ValueData: "{uninstallexe}"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "{#MyAppClientAppPathsKey}"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "{#MyAppClientAppPathsKey}"; ValueType: string; ValueName: "Path"; ValueData: "{app}"; Flags: uninsdeletekey

[Icons]
Name: "{group}\openETQW"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{group}\openETQW Dedicated Server"; Filename: "{app}\{#MyAppServerExeName}"; WorkingDir: "{app}"
Name: "{group}\Read Me"; Filename: "{app}\README.txt"
Name: "{group}\Uninstall openETQW"; Filename: "{uninstallexe}"
Name: "{autodesktop}\openETQW"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Launch openETQW"; WorkingDir: "{app}"; Flags: postinstall nowait skipifsilent unchecked

[Code]
const
  openETQWInstallRegKey = '{#MyAppInstallRegKey}';
  openETQWDefaultInstallDir = '{localappdata}\Programs\openETQW';

function GetDefaultInstallDir(Param: String): String;
var
  InstallDir: String;
begin
  if RegQueryStringValue(HKEY_AUTO, openETQWInstallRegKey, 'InstallDir', InstallDir) and (InstallDir <> '') then
    Result := InstallDir
  else
    Result := ExpandConstant(openETQWDefaultInstallDir);
end;

function FormatExistingInstallSummary: String;
var
  InstallDir: String;
  InstallVersion: String;
  InstallArch: String;
begin
  Result := '';
  if not RegQueryStringValue(HKEY_AUTO, openETQWInstallRegKey, 'InstallDir', InstallDir) then
    Exit;
  if InstallDir = '' then
    Exit;

  RegQueryStringValue(HKEY_AUTO, openETQWInstallRegKey, 'InstallVersion', InstallVersion);
  RegQueryStringValue(HKEY_AUTO, openETQWInstallRegKey, 'InstallArch', InstallArch);

  Result := 'Existing openETQW installation detected';
  if InstallVersion <> '' then
    Result := Result + ': version ' + InstallVersion;
  if InstallArch <> '' then
    Result := Result + ' (' + Uppercase(InstallArch) + ')';
  Result := Result + '.' + #13#10 + InstallDir + #13#10 +
    'Setup will reuse that install location unless you choose a different folder.';
end;

procedure InitializeWizard;
var
  ExistingInstallSummary: String;
begin
  ExistingInstallSummary := FormatExistingInstallSummary;
  if ExistingInstallSummary <> '' then
    WizardForm.WelcomeLabel2.Caption :=
      WizardForm.WelcomeLabel2.Caption + #13#10#13#10 + ExistingInstallSummary;
end;
